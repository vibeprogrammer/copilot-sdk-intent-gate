# --- The assistant (Copilot SDK) -------------------------------------------------------------
# Leave MODEL_PROVIDER_TYPE empty to use your GitHub Copilot sign-in (the SDK's default auth).
# Or bring your own key (BYOK, see github/copilot-sdk docs/auth/byok.md):
MODEL_PROVIDER_TYPE=openai          # openai | azure | anthropic
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL=gpt-4.1-mini

# --- The gate --------------------------------------------------------------------------------
INTENT_AGENT_URL=http://127.0.0.1:6003/
# This app's own Bearer token for intent-agent (intent-agent introspects it). The stand-in
# introspection accepts any non-empty value.
INTENT_AGENT_TOKEN=local-app-token
# An AuthZEN 1.0 PDP base URL: the stand-in locally, or IndyKite's regional API.
AUTHZEN_PDP_URL=http://127.0.0.1:9002
# Sent as X-IK-ClientKey (IndyKite's AppAgent credentials token). The stand-in checks it equals
# IK_APP_AGENT_KEY below.
AUTHZEN_PDP_CLIENT_KEY=eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJnaWQ6bG9jYWwtc3RhbmRpbi1lbnZpcm9ubWVudCJ9.
# Optional user access token, sent as Authorization: Bearer, for policies that read token claims.
AUTHZEN_PDP_TOKEN=
GATE_TIMEOUT_SECONDS=20

# --- intent-agent (used by docker-compose.yml) -------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# The stand-in's key: an UNSIGNED JWT whose only claim is sub=gid:local-standin-environment.
# intent-agent only reads its sub claim (to scope its cache). It is not a secret. With a real
# IndyKite project, put your AppAgent credentials token here and in AUTHZEN_PDP_CLIENT_KEY.
IK_APP_AGENT_KEY=eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJnaWQ6bG9jYWwtc3RhbmRpbi1lbnZpcm9ubWVudCJ9.
